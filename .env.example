SELTIVO_PUBLIC_ORIGIN=http://localhost:3000
SELTIVO_DB_PATH=./data/seltivo.db
HOST=127.0.0.1
PORT=4000
SELTIVO_TRUST_PROXY=0
# 1 = нові акаунти потенційно не верифіковані (потрібен BREVO_API_KEY + BREVO_SENDER_EMAIL)
SELTIVO_REQUIRE_EMAIL_VERIFICATION=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SELTIVO_DEV_MAIL=console
SELTIVO_TEAM_EMAIL=
# 1 = увімкнути самообслуговування DELETE /api/v1/me (інакше доступне лише адміністратору)
# Перед увімкненням у production: перевірити restore та незалежні копії (див. docs/cloudflare-operations.md).
SELTIVO_ACCOUNT_DELETION_ENABLED=0
# Run bootstrap-admin with these set only once, then remove them:
SELTIVO_ADMIN_EMAIL=
SELTIVO_ADMIN_PASSWORD=
