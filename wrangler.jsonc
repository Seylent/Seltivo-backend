{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seltivo-api",
  "account_id": "642a1378267910de72f484b86dd6eb73",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SELTIVO_PUBLIC_ORIGIN": "https://seltivostudio.com",
    "SELTIVO_ADMIN_EMAIL": "seltivostudio@gmail.com",
    "SELTIVO_REQUIRE_EMAIL_VERIFICATION": "1",
    // Власник підтвердив підключення 2FA для всіх production-адміністраторів 2026-11-22.
    "SELTIVO_REQUIRE_ADMIN_2FA": "1"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SELTIVO", "class_name": "SeltivoData" },
      { "name": "SELTIVO_DELETIONS", "class_name": "DeletionLedger" }
    ]
  },
  "r2_buckets": [
    { "binding": "SELTIVO_BACKUP_BUCKET", "bucket_name": "seltivo-backups" },
    { "binding": "SELTIVO_SITE_DATA", "bucket_name": "seltivo-data" }
  ],
  "triggers": { "crons": ["0 2 * * *", "10 * * * *"] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SeltivoData"] },
    { "tag": "v2", "new_sqlite_classes": ["DeletionLedger"] }
  ],
  "observability": { "enabled": true, "redact_query_string": true },
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "SELTIVO_PUBLIC_ORIGIN": "https://seltivo-staging.seltivostudio.workers.dev",
        "SELTIVO_ADMIN_EMAIL": "seltivostudio@gmail.com",
        "SELTIVO_REQUIRE_ADMIN_2FA": "0"
      },
      "durable_objects": {
        "bindings": [
          { "name": "SELTIVO", "class_name": "SeltivoData" },
          { "name": "SELTIVO_DELETIONS", "class_name": "DeletionLedger" }
        ]
      },
      "r2_buckets": [
        { "binding": "SELTIVO_BACKUP_BUCKET", "bucket_name": "seltivo-staging-backups" },
        { "binding": "SELTIVO_SITE_DATA", "bucket_name": "seltivo-staging-data" }
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["SeltivoData"] },
        { "tag": "v2", "new_sqlite_classes": ["DeletionLedger"] }
      ],
      "observability": { "enabled": true, "redact_query_string": true }
    }
  }
}
