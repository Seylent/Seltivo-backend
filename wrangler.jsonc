{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seltivo-api",
  "account_id": "642a1378267910de72f484b86dd6eb73",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "vars": {
    "SELTIVO_PUBLIC_ORIGIN": "https://seltivo.seltivostudio.workers.dev",
    "SELTIVO_ADMIN_EMAIL": "seltivostudio@gmail.com",
    // Тимчасово 0: у production немає Brevo-секретів, інакше воркер падає при старті.
    "SELTIVO_REQUIRE_EMAIL_VERIFICATION": "0",
    // Після увімкнення 2FA на всіх адмінських акаунтах виставити "1".
    "SELTIVO_REQUIRE_ADMIN_2FA": "0"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SELTIVO", "class_name": "SeltivoData" },
      { "name": "SELTIVO_DELETIONS", "class_name": "DeletionLedger" }
    ]
  },
  "r2_buckets": [{ "binding": "SELTIVO_BACKUP_BUCKET", "bucket_name": "seltivo-backups" }],
  "triggers": { "crons": ["0 2 * * *", "10 * * * *"] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SeltivoData"] },
    { "tag": "v2", "new_sqlite_classes": ["DeletionLedger"] }
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "vars": {
        "SELTIVO_PUBLIC_ORIGIN": "https://seltivo-staging.seltivostudio.workers.dev",
        "SELTIVO_ADMIN_EMAIL": "seltivostudio@gmail.com",
        "SELTIVO_REQUIRE_ADMIN_2FA": "0"
      },
      "durable_objects": {
        "bindings": [
          { "name": "SELTIVO", "class_name": "SeltivoData" },
          { "name": "SELTIVO_DELETIONS", "class_name": "DeletionLedger" }
        ]
      },
      "r2_buckets": [{ "binding": "SELTIVO_BACKUP_BUCKET", "bucket_name": "seltivo-staging-backups" }],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["SeltivoData"] },
        { "tag": "v2", "new_sqlite_classes": ["DeletionLedger"] }
      ],
      "observability": { "enabled": true }
    }
  }
}
